{
  "rewrites": [
    { "source": "/", "destination": "/driving-mhe.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" },
        { "key": "Permissions-Policy", "value": "gamepad=*, fullscreen=*, autoplay=*" }
      ]
    }
  ]
}
